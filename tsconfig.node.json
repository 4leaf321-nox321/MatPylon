{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": { "@engine/*": ["src/engine/*"], "@shared/*": ["src/shared/*"] }
  },
  "//": "화면 테스트(tests/renderer)는 JSX·DOM 이 필요해 tsconfig.json 쪽이 본다.",
  "include": [
    "electron",
    "src/engine",
    "src/shared",
    "tests/architecture",
    "tests/engine",
    "vite.config.ts",
    "vitest.config.ts"
  ]
}
